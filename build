#!/bin/bash
set -euo pipefail

# basic build script

if [[ $# -lt 1 ]]; then
    echo "Usage: $0 <file.cpp>" >&2
    exit 1
fi

src="$1"
shift

if [[ ! -f "$src" ]]; then
    echo "error: no such file: $src" >&2
    exit 1
fi

CXX=$(command -v g++-11 || command -v g++)

builddir="$HOME/.cpp/build"
mkdir -p "$builddir"

bin="$builddir/$(basename "${src%.*}")"

"$CXX" -O2 -std=c++17 -static -o "$bin" "$src"
"$bin" "$@"
