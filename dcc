#!/bin/bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "Usage: $0 <file.cpp> [args passed to the program...]" >&2
    exit 1
fi

src="$1"
shift

if [[ ! -f "$src" ]]; then
    echo "error: no such file: $src" >&2
    exit 1
fi

CXX=$(command -v g++-11 || command -v g++)

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
builddir="$root/.build"
mkdir -p "$builddir"

bin="$builddir/$(basename "${src%.*}")"

"$CXX" -O2 -std=c++17 -static -o "$bin" "$src"
"$bin" "$@"
